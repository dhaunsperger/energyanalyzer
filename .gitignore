# Private user data & caches — never commit (README documents the layout)
data/*
!data/README.md

# ERCOT settlement-point prices: public market data (the RTMLZHBSPP reports),
# not private user data -- tracked so a cloud session without local file access
# can still price RTW-indexed plans.
!data/ercot/
# ...but not the per-zone parquet cache derived from them. Its manifest keys on
# source-file mtimes, which a fresh clone resets, so every checkout rebuilds it
# on first load and would otherwise leave the tree dirty.
data/ercot/*.parquet
data/ercot/*.manifest.json

# Frozen benchmark archive: the plan YAMLs, tariff, and README are tracked,
# but the interval usage CSV is private user data (same reason as data/) —
# keep it local-only. The benchmark test skips gracefully when it's absent.
tests/fixtures/benchmark_2026_07/IntervalData.csv

# Draft plans are regenerated on every "Refresh market data" run — scratch
# review space, not part of the git-versioned plan database in plans/.
plans/drafts/

# Streamlit agent skills (environment-specific symlinks)
.agents/skills/developing-with-streamlit/
.claude/skills/developing-with-streamlit/

__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.ruff_cache/
.venv/
.streamlit/secrets.toml
